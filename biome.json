{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!**/.cache",
      "!**/dist",
      "!**/node_modules",
      "!**/.omc",
      "!**/.claude",
      "!**/package-lock.json",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "json": { "formatter": { "trailingCommas": "none" } },
  "linter": { "rules": { "preset": "recommended" } }
}
